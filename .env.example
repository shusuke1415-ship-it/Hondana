# Amazon Associates (アマゾンアソシエイト) のトラッキングID
# https://affiliate.amazon.co.jp/ で登録後に発行される「アソシエイトID」を入力してください
# 未設定でも動作しますが、購入リンクに成果報酬用のタグが付きません
VITE_AMAZON_ASSOCIATE_TAG=

# Rakuten Books API (https://webservice.rakuten.co.jp/ で無料登録)
# 未設定の場合は、openBDベースの静的な78冊フィードにフォールバックします
VITE_RAKUTEN_APPLICATION_ID=
VITE_RAKUTEN_ACCESS_KEY=
# 楽天アプリ設定の「許可されたウェブサイト」に登録したドメイン(例: *.example.com の場合は https://example.com)
# ローカル開発時、Viteのdevプロキシがこのドメインを装ってOrigin/Refererヘッダーを付与します
VITE_RAKUTEN_ALLOWED_ORIGIN=
