# Amazon Associates (アマゾンアソシエイト) のトラッキングID
# https://affiliate.amazon.co.jp/ で登録後に発行される「アソシエイトID」を入力してください
# 未設定でも動作しますが、購入リンクに成果報酬用のタグが付きません
VITE_AMAZON_ASSOCIATE_TAG=

# Rakuten Books API (https://webservice.rakuten.co.jp/ で無料登録)
# サーバー専用の変数です（VITE_プレフィックスなし = クライアントに一切露出しません）。
# server/rakutenProxy.ts が読み込み、api/books.ts (本番) と
# Viteのdevミドルウェア (ローカル) の両方から使われます。
# 未設定の場合は、openBDベースの静的な78冊フィードに自動フォールバックします。
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
# 楽天アプリ設定の「許可されたウェブサイト」に登録したドメイン
RAKUTEN_ALLOWED_ORIGIN=
